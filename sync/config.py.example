# -*- coding: utf-8 -*-
"""配置示例 —— 复制成 config.py 再改

不要把真实的 config.py 提交到仓库（.gitignore 已经排除了）。
也可以不用这个文件，直接设环境变量：

    export SYNC_HOST=http://你的服务器
    export SYNC_TOKEN=你的同步口令
"""

# 你的同步服务器地址（带 http:// 或 https://）
HOST = "http://YOUR_SERVER"

# 同步口令（跟你服务器上的一致）
TOKEN = "YOUR_SYNC_TOKEN"

# 显示对话时用的名字
WHO = {
    "user": "用户",
    "sister": "AI（另一处）",
    "assistant": "AI",
}
