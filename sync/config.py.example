# -*- coding: utf-8 -*-
"""配置示例 —— 复制成 config.py 再改

    cp sync/config.py.example sync/config.py

**别把真实的 config.py 提交到仓库**（.gitignore 已经排除了）。
也可以不用这个文件，直接设环境变量，名字写在每项后面。
"""

# 你的同步服务器地址，带 http:// 或 https://      环境变量：SYNC_HOST
HOST = "http://YOUR_SERVER"

# 同步口令，跟服务器上设的一致                      环境变量：SYNC_TOKEN
TOKEN = "YOUR_SYNC_TOKEN"

# 日志目录：MEMORY.md 和每天的日志放在哪           环境变量：MEM_DIR
# 留空就用本目录下的 memory/daily
MEM_DIR = ""

# 对话工程目录：电脑端的对话从这里读出来推给另一处   环境变量：PROJ
# 留空就用本目录下的 memory/projects
PROJ = ""

# 装了依赖的那个 python（视频分析、对话归档要用 paramiko）
# 留空就用当前跑 watch_memory.py 的那个            环境变量：PY_EXE
PY_EXE = ""

# 显示对话时用的名字
WHO = {
    "user": "用户",
    "sister": "AI（另一处）",
    "assistant": "AI",
}
